@model LinkUpPro.Application.DTOs.User.UserProfileDto
@{
    ViewData["Title"] = Model.FirstName + " " + Model.LastName;
    Layout = "_Layout";
    bool isOwner = ViewBag.IsOwner ?? false;
    var posts = ViewBag.Posts as List<LinkUpPro.Application.ViewModels.Post.PostViewModel> ?? new List<LinkUpPro.Application.ViewModels.Post.PostViewModel>();
}

<div class="flex flex-col gap-6">
    <!-- Header del Perfil -->
    <div class="card-static p-0 overflow-hidden relative">
        <!-- Banner de fondo dinámico -->
        <div class="h-48 w-full bg-gradient-to-r from-secondary to-accent opacity-80"></div>
        
        <div class="px-8 pb-8">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-end -mt-16 gap-6">
                
                <div class="flex flex-col md:flex-row items-center md:items-end gap-6 relative z-10">
                    <div class="w-32 h-32 rounded-full border-4 border-primary bg-primary overflow-hidden shadow-xl">
                        @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                        {
                            <img src="@Model.ProfilePictureUrl" alt="@Model.FirstName" class="w-full h-full object-cover" />
                        }
                        else
                        {
                            <div class="w-full h-full bg-gradient-to-br from-gray-700 to-gray-900 flex items-center justify-center text-4xl font-bold text-white">
                                @Model.FirstName.Substring(0, 1).ToUpper()
                            </div>
                        }
                    </div>
                    
                    <div class="text-center md:text-left mb-2">
                        <h1 class="text-3xl font-bold text-white">@Model.FirstName @Model.LastName</h1>
                        <p class="text-text-muted">@@@Model.Username • @Model.Email</p>
                    </div>
                </div>
                
                <div class="w-full md:w-auto flex gap-3 z-10">
                    @if (isOwner)
                    {
                        <a asp-action="Edit" class="btn-primary-custom px-6 py-2">
                            Editar Perfil
                        </a>
                    }
                    else
                    {
                        <!-- Lógica visual de amigos (dummy status para demostración) -->
                        var areFriends = ViewBag.AreFriends ?? false;
                        if (areFriends)
                        {
                            <button class="px-6 py-2 bg-white/10 border border-white/20 text-white rounded-lg hover:bg-white/20 transition-colors font-medium flex items-center gap-2">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                Amigos
                            </button>
                        }
                        else
                        {
                            <button class="btn-primary-custom px-6 py-2 flex items-center gap-2">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                Añadir a Amigos
                            </button>
                        }
                    }
                </div>
            </div>
            
            <div class="mt-8 flex gap-8 text-center md:text-left border-t border-card-border/50 pt-6">
                <div>
                    <span class="block text-2xl font-bold text-white">@ViewBag.FriendsCount</span>
                    <span class="text-xs text-text-muted uppercase tracking-wider">Amigos</span>
                </div>
                <div>
                    <span class="block text-2xl font-bold text-white">@posts.Count</span>
                    <span class="text-xs text-text-muted uppercase tracking-wider">Publicaciones</span>
                </div>
                @if (!isOwner)
                {
                    <div>
                        <span class="block text-2xl font-bold text-white">@ViewBag.MutualFriendsCount</span>
                        <span class="text-xs text-text-muted uppercase tracking-wider">En Común</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Muro / Publicaciones -->
    <div class="flex flex-col md:flex-row gap-6">
        <div class="w-full md:w-1/3 flex flex-col gap-4">
            <div class="card-static">
                <h3 class="label-custom mb-4 text-white">Detalles</h3>
                <div class="space-y-3 text-sm text-text-muted">
                    @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                    {
                        <div class="flex items-center gap-3">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                            @Model.PhoneNumber
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="w-full md:w-2/3 flex flex-col gap-6">
            @if (isOwner)
            {
                <div class="card-static">
                    <form asp-controller="Post" asp-action="Create" method="get">
                        <div class="flex gap-4">
                            <div class="w-10 h-10 rounded-full bg-primary flex-shrink-0 flex items-center justify-center text-white overflow-hidden border border-card-border">
                                @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
                                {
                                    <img src="@Model.ProfilePictureUrl" class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    <span>@Model.FirstName.Substring(0,1)</span>
                                }
                            </div>
                            <button type="submit" class="w-full bg-[#111827] border border-[#374151] rounded-full px-4 text-left text-text-muted hover:bg-[#1f2937] transition-colors focus:outline-none focus:ring-1 focus:ring-accent">
                                ¿Qué estás pensando, @Model.FirstName?
                            </button>
                        </div>
                    </form>
                </div>
            }

            @if (posts.Any())
            {
                foreach (var post in posts.OrderByDescending(p => p.CreatedAt))
                {
                    <partial name="_PostCard" model="post" />
                }
            }
            else
            {
                <div class="card-static text-center py-12">
                    <p class="text-text-muted">No hay publicaciones para mostrar.</p>
                </div>
            }
        </div>
    </div>
</div>
