@model LinkUpPro.Application.DTOs.User.UserProfileDto
@{
    ViewData["Title"] = $"Perfil de {Model.FirstName} {Model.LastName}";
}

<div class="max-w-3xl mx-auto space-y-8">
    <!-- Header del Perfil -->
    <div class="card-static relative overflow-hidden">
        <!-- Banner Background -->
        <div class="absolute top-0 left-0 w-full h-32 bg-gradient-to-r from-secondary/40 to-accent/40 blur-xl"></div>
        
        <div class="relative pt-12 px-6 flex flex-col md:flex-row items-center md:items-end gap-6 pb-6">
            @if (!string.IsNullOrEmpty(Model.ProfilePictureUrl))
            {
                <img src="@Model.ProfilePictureUrl" alt="@Model.FirstName" class="w-32 h-32 rounded-full object-cover shadow-2xl border-4 border-primary z-10" />
            }
            else
            {
                <div class="w-32 h-32 rounded-full bg-gradient-to-br from-secondary to-accent flex items-center justify-center shadow-2xl border-4 border-primary z-10">
                    <span class="text-4xl font-bold text-white">@Model.FirstName.Substring(0, 1).ToUpper()</span>
                </div>
            }
            
            <div class="flex-grow text-center md:text-left z-10 mb-2">
                <h1 class="text-3xl font-bold text-white tracking-tight">@Model.FirstName @Model.LastName</h1>
                <p class="text-accent font-medium mt-1">@@@Model.Username</p>
            </div>
            
            <div class="z-10 flex gap-3">
                <a asp-controller="BattleshipGameCreate" asp-action="Create" class="btn-primary-custom flex items-center gap-2 px-6">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    Retar a Battleship
                </a>
            </div>
        </div>
    </div>

    <!-- Información -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="card-static space-y-6">
            <h3 class="text-xl font-bold border-b border-card-border pb-3">Información de Contacto</h3>
            
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 text-accent">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                </div>
                <div>
                    <p class="text-sm text-text-muted">Correo Electrónico</p>
                    <p class="font-medium">@Model.Email</p>
                </div>
            </div>
            
            <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 text-accent">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                </div>
                <div>
                    <p class="text-sm text-text-muted">Teléfono</p>
                    <p class="font-medium">@Model.PhoneNumber</p>
                </div>
            </div>
        </div>

        <div class="card-static space-y-4">
            <h3 class="text-xl font-bold border-b border-card-border pb-3">Estado de la cuenta</h3>
            
            <div class="flex items-center gap-3">
                @if (Model.IsActive)
                {
                    <span class="relative flex h-3 w-3">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                    </span>
                    <span class="font-medium text-green-400">Cuenta Activa</span>
                }
                else
                {
                    <span class="w-3 h-3 rounded-full bg-red-500"></span>
                    <span class="font-medium text-red-400">Cuenta Inactiva</span>
                }
            </div>
            
            <div class="pt-4">
                <button type="button" onclick="loadMutualFriends('@Model.Id', '@Model.FirstName')" class="w-full bg-white/5 hover:bg-white/10 text-white font-semibold rounded-lg px-4 py-3 border border-white/10 transition-colors flex items-center justify-center gap-2">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    Ver amigos en común
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Amigos en Común (Reutilizado) -->
<div id="mutualFriendsModal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/60 backdrop-blur-sm">
    <div class="bg-primary border border-card-border rounded-2xl p-6 w-full max-w-md shadow-2xl transform transition-all scale-95 opacity-0" id="mutualFriendsContent">
        <div class="flex justify-between items-center mb-4">
            <h3 class="text-xl font-bold" id="mutualFriendsTitle">Amigos en común</h3>
            <button type="button" onclick="closeMutualFriends()" class="text-text-muted hover:text-white">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        <div id="mutualFriendsList" class="max-h-96 overflow-y-auto pr-2 space-y-3">
            <div class="flex justify-center p-4">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadMutualFriends(friendId, friendName) {
            $('#mutualFriendsTitle').text('Amigos en común con ' + friendName);
            $('#mutualFriendsModal').removeClass('hidden').addClass('flex');
            setTimeout(() => {
                $('#mutualFriendsContent').removeClass('scale-95 opacity-0').addClass('scale-100 opacity-100');
            }, 10);
            
            $('#mutualFriendsList').html('<div class="flex justify-center p-4"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-accent"></div></div>');

            $.get('@Url.Action("MutualFriends", "FriendList")?friendId=' + friendId, function (data) {
                $('#mutualFriendsList').html(data);
            }).fail(function() {
                $('#mutualFriendsList').html('<p class="text-red-400 text-center py-4">Error al cargar.</p>');
            });
        }

        function closeMutualFriends() {
            $('#mutualFriendsContent').removeClass('scale-100 opacity-100').addClass('scale-95 opacity-0');
            setTimeout(() => {
                $('#mutualFriendsModal').removeClass('flex').addClass('hidden');
            }, 200);
        }
    </script>
}
