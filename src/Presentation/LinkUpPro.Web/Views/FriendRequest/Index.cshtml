@model List<LinkUpPro.Application.DTOs.Friendship.FriendRequestDto>
@{
    ViewData["Title"] = "Solicitudes de Amistad";
    var activeTab = ViewBag.ActiveTab as string ?? "received";
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex justify-between items-center mb-8">
        <div>
            <h1 class="text-3xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-indigo-400 to-blue-500">Solicitudes de Amistad</h1>
            <p class="text-text-muted mt-2">Gestiona las solicitudes que has recibido y enviado.</p>
        </div>
        <a asp-controller="FriendRequestSend" asp-action="Create" class="btn-primary-custom">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="20" y1="8" x2="20" y2="14"></line>
                <line x1="23" y1="11" x2="17" y2="11"></line>
            </svg>
            Nueva Solicitud
        </a>
    </div>

    <!-- Pestañas -->
    <div class="flex border-b border-card-border mb-6">
        <a href="@Url.Action("Index", "FriendRequestList", new { tab = "received" })" class="px-6 py-3 font-semibold transition-colors border-b-2 @(activeTab == "received" ? "text-indigo-400 border-indigo-500" : "text-text-muted border-transparent hover:text-white hover:border-white/30")">
            Recibidas
        </a>
        <a href="@Url.Action("Index", "FriendRequestList", new { tab = "sent" })" class="px-6 py-3 font-semibold transition-colors border-b-2 @(activeTab == "sent" ? "text-indigo-400 border-indigo-500" : "text-text-muted border-transparent hover:text-white hover:border-white/30")">
            Enviadas
        </a>
    </div>

    <!-- Lista -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        @if (!Model.Any())
        {
            <div class="col-span-1 md:col-span-2 card-static text-center py-12">
                <p class="text-text-muted">No hay solicitudes para mostrar en esta sección.</p>
            </div>
        }
        else
        {
            foreach (var req in Model)
            {
                <div class="card-static flex items-center justify-between">
                    <div class="flex items-center gap-4">
                        @if (activeTab == "received")
                        {
                            @if (!string.IsNullOrEmpty(req.SenderProfilePicture))
                            {
                                <img src="@req.SenderProfilePicture" alt="@req.SenderName" class="w-12 h-12 rounded-full object-cover shadow-lg border border-white/10" />
                            }
                            else
                            {
                                <div class="w-12 h-12 rounded-full bg-gradient-to-br from-indigo-500 to-blue-600 flex items-center justify-center shadow-lg border border-white/10">
                                    <span class="text-lg font-bold">@req.SenderName.Substring(0, 1).ToUpper()</span>
                                </div>
                            }
                        }
                        
                        <div>
                            @if (activeTab == "received")
                            {
                                <h3 class="font-bold text-lg">@req.SenderName</h3>
                                <p class="text-sm text-text-muted">Hace @((int)(DateTime.UtcNow - req.CreatedAt).TotalHours)h</p>
                            }
                            else
                            {
                                <h3 class="font-bold text-lg">Para: Usuario @req.ReceiverId.ToString().Substring(0, 5)</h3>
                                <p class="text-sm text-text-muted">Hace @((int)(DateTime.UtcNow - req.CreatedAt).TotalHours)h</p>
                            }
                        </div>
                    </div>
                    
                    <div class="flex gap-2">
                        @if (activeTab == "received")
                        {
                            <form asp-controller="FriendRequestAccept" asp-action="Accept" method="post">
                                <input type="hidden" name="requestId" value="@req.Id" />
                                <button type="submit" class="p-2 bg-green-500/20 text-green-400 hover:bg-green-500 hover:text-white rounded-lg transition-colors" title="Aceptar">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                </button>
                            </form>
                            <form asp-controller="FriendRequestReject" asp-action="Reject" method="post">
                                <input type="hidden" name="requestId" value="@req.Id" />
                                <button type="submit" class="p-2 bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white rounded-lg transition-colors" title="Rechazar">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                                </button>
                            </form>
                        }
                        else
                        {
                            <form asp-controller="FriendRequestCancel" asp-action="Cancel" method="post">
                                <input type="hidden" name="requestId" value="@req.Id" />
                                <button type="submit" class="px-3 py-2 text-sm bg-red-500/20 text-red-400 hover:bg-red-500 hover:text-white rounded-lg transition-colors">
                                    Cancelar
                                </button>
                            </form>
                            <!-- Eliminar lógica del historial -->
                            <form asp-controller="FriendRequestHide" asp-action="Hide" method="post" onsubmit="return confirm('¿Deseas eliminar esta solicitud de tu historial?');">
                                <input type="hidden" name="requestId" value="@req.Id" />
                                <button type="submit" class="px-3 py-2 text-sm bg-white/5 hover:bg-white/10 text-white rounded-lg transition-colors" title="Eliminar del historial">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>
