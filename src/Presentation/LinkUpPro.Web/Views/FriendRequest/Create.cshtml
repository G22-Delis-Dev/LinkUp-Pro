@model LinkUpPro.Application.ViewModels.Friendship.SendFriendRequestViewModel
@{
    ViewData["Title"] = "Añadir un amigo";
}

<div class="max-w-2xl mx-auto">
    <div class="card-static">
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-accent/20 text-accent mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <line x1="19" y1="8" x2="19" y2="14"></line>
                    <line x1="22" y1="11" x2="16" y2="11"></line>
                </svg>
            </div>
            <h1 class="text-3xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-accent to-secondary">
                Añadir un amigo
            </h1>
            <p class="text-text-muted mt-2">Busca un usuario por su nombre para enviarle una solicitud de amistad.</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
                @TempData["Error"]
            </div>
        }

        <form asp-controller="FriendRequestSend" asp-action="Send" method="post" id="sendRequestForm" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReceiverId" id="receiverIdInput" />

            <!-- Buscador -->
            <div>
                <label class="label-custom">Buscar usuario</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-text-muted">
                        <svg id="searchIcon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                        </svg>
                        <svg id="loadingIcon" class="hidden animate-spin" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 12a9 9 0 1 1-6.219-8.56"></path>
                        </svg>
                    </div>
                    <input
                        type="text"
                        id="searchInput"
                        class="input-custom pl-10 pr-10"
                        placeholder="Escribe un nombre..."
                        autocomplete="off" />
                    <button type="button" id="clearSearch" class="hidden absolute inset-y-0 right-0 pr-3 flex items-center text-text-muted hover:text-white transition-colors">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
                <p class="text-xs text-text-muted mt-2">Mínimo 2 caracteres. Solo se muestran usuarios sin amistad ni solicitud pendiente.</p>
            </div>

            <!-- Resultados de búsqueda -->
            <div id="searchResults" class="hidden space-y-3">
                <p class="text-xs font-semibold uppercase tracking-widest text-text-muted">Resultados</p>
                <div id="resultsList" class="space-y-2 max-h-72 overflow-y-auto pr-1"></div>
            </div>

            <!-- Usuario seleccionado -->
            <div id="selectedUser" class="hidden p-4 rounded-xl border border-accent/50 bg-accent/5 flex items-center gap-4">
                <div id="selectedAvatar" class="w-12 h-12 rounded-full flex items-center justify-center bg-accent/20 text-accent font-bold text-lg flex-shrink-0"></div>
                <div class="flex-1 min-w-0">
                    <p class="font-semibold text-white truncate" id="selectedName"></p>
                    <p class="text-xs text-accent mt-0.5">Seleccionado como destinatario</p>
                </div>
                <button type="button" id="deselectUser" class="text-text-muted hover:text-white transition-colors flex-shrink-0">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>

            <!-- Botón de envío -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-800/80">
                <a asp-controller="FriendList" asp-action="Index" class="btn-secondary-custom">
                    Cancelar
                </a>
                <button type="submit" id="submitBtn" disabled
                    class="btn-primary-custom disabled:opacity-40 disabled:cursor-not-allowed disabled:shadow-none">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="22" y1="2" x2="11" y2="13"></line>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                    Enviar Solicitud
                </button>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    const searchInput  = document.getElementById('searchInput');
    const resultsList  = document.getElementById('resultsList');
    const searchResults = document.getElementById('searchResults');
    const selectedUser = document.getElementById('selectedUser');
    const selectedName = document.getElementById('selectedName');
    const selectedAvatar = document.getElementById('selectedAvatar');
    const receiverIdInput = document.getElementById('receiverIdInput');
    const submitBtn    = document.getElementById('submitBtn');
    const clearBtn     = document.getElementById('clearSearch');
    const loadingIcon  = document.getElementById('loadingIcon');
    const searchIcon   = document.getElementById('searchIcon');
    let debounceTimer  = null;

    function showLoading(show) {
        loadingIcon.classList.toggle('hidden', !show);
        searchIcon.classList.toggle('hidden', show);
    }

    function getInitials(name) {
        return name.split(' ').slice(0, 2).map(n => n[0]).join('').toUpperCase();
    }

    function renderResults(users) {
        resultsList.innerHTML = '';

        if (!users || users.length === 0) {
            resultsList.innerHTML = '<p class="text-center text-text-muted py-6 text-sm">No se encontraron usuarios.</p>';
            searchResults.classList.remove('hidden');
            return;
        }

        users.forEach(user => {
            const card = document.createElement('button');
            card.type = 'button';
            card.className = 'w-full flex items-center gap-3 p-3 rounded-xl hover:bg-white/5 border border-transparent hover:border-accent/30 transition-all text-left group';
            card.dataset.id = user.id;
            card.dataset.name = user.fullName;
            card.dataset.picture = user.profilePictureUrl || '';

            const avatarHtml = user.profilePictureUrl
                ? `<img src="${user.profilePictureUrl}" class="w-10 h-10 rounded-full object-cover flex-shrink-0" alt="${user.fullName}" />`
                : `<div class="w-10 h-10 rounded-full bg-accent/20 text-accent font-bold text-sm flex items-center justify-center flex-shrink-0">${getInitials(user.fullName)}</div>`;

            card.innerHTML = `
                ${avatarHtml}
                <span class="flex-1 font-medium text-white group-hover:text-accent transition-colors truncate">${user.fullName}</span>
                <span class="text-xs text-accent opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0">Seleccionar</span>
            `;

            card.addEventListener('click', () => selectUser(user));
            resultsList.appendChild(card);
        });

        searchResults.classList.remove('hidden');
    }

    function selectUser(user) {
        receiverIdInput.value = user.id;
        selectedName.textContent = user.fullName;
        selectedAvatar.innerHTML = user.profilePictureUrl
            ? `<img src="${user.profilePictureUrl}" class="w-full h-full rounded-full object-cover" alt="${user.fullName}" />`
            : getInitials(user.fullName);
        selectedUser.classList.remove('hidden');
        searchResults.classList.add('hidden');
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        submitBtn.disabled = false;
    }

    function deselectUser() {
        receiverIdInput.value = '';
        selectedUser.classList.add('hidden');
        submitBtn.disabled = true;
        searchInput.focus();
    }

    document.getElementById('deselectUser').addEventListener('click', deselectUser);

    clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        clearBtn.classList.add('hidden');
        searchResults.classList.add('hidden');
        searchInput.focus();
    });

    searchInput.addEventListener('input', function () {
        const q = this.value.trim();
        clearBtn.classList.toggle('hidden', q.length === 0);
        clearTimeout(debounceTimer);

        if (q.length < 2) {
            searchResults.classList.add('hidden');
            showLoading(false);
            return;
        }

        showLoading(true);
        debounceTimer = setTimeout(async () => {
            try {
                const resp = await fetch(`/FriendRequestSend/SearchUsers?q=${encodeURIComponent(q)}`);
                const users = await resp.json();
                renderResults(users);
            } catch (e) {
                resultsList.innerHTML = '<p class="text-center text-red-400 py-6 text-sm">Error al buscar usuarios.</p>';
                searchResults.classList.remove('hidden');
            } finally {
                showLoading(false);
            }
        }, 350);
    });

    // Cerrar resultados al hacer clic fuera
    document.addEventListener('click', function (e) {
        if (!e.target.closest('#searchInput') && !e.target.closest('#resultsList')) {
            searchResults.classList.add('hidden');
        }
    });
})();
</script>
