@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = "_Layout";
}

<div class="min-h-[80vh] flex items-center justify-center p-4 relative overflow-hidden">
    <div class="w-full max-w-md bg-card-bg border border-card-border rounded-2xl p-8 backdrop-blur-md shadow-2xl relative z-10">
        <h2 class="text-2xl font-bold text-text-primary text-center mb-2">Bienvenido de vuelta</h2>
        <p class="text-text-muted text-center mb-6">Inicia sesión para continuar en LinkUp Pro</p>

        <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="bg-red-500/10 border border-red-500/50 text-red-500 rounded-lg p-3 mb-4 text-sm"></div>

            <div class="mb-4">
                <label asp-for="Username" class="label-custom">Usuario</label>
                <input asp-for="Username" class="input-custom" placeholder="Ingresa tu usuario" autocomplete="username" />
                <span asp-validation-for="Username" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="label-custom">Contraseña</label>
                <input asp-for="Password" type="password" class="input-custom" placeholder="••••••••" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-red-500 text-xs mt-1 block"></span>
            </div>
            
            <div class="flex justify-between items-center mb-6">
                <label class="flex items-center text-sm text-text-muted cursor-pointer hover:text-white transition-colors">
                    <input asp-for="RememberMe" type="checkbox" class="mr-2 w-4 h-4 rounded border-gray-600 bg-gray-700 text-accent focus:ring-accent focus:ring-offset-gray-800" /> 
                    Recordarme
                </label>
                <a asp-action="ForgotPassword" class="text-sm text-accent hover:text-white transition-colors">¿Olvidaste tu contraseña?</a>
            </div>

            <button type="submit" class="btn-primary-custom w-full">
                Iniciar Sesión
            </button>
        </form>

        @if (ViewBag.ShowResendActivation == true)
        {
            <div class="mt-4 text-center">
                <form asp-action="ResendActivation" method="post">
                    <input type="hidden" name="username" value="@ViewBag.Username" />
                    <button type="submit" class="w-full bg-white/5 border border-white/10 text-white font-medium rounded-lg px-4 py-3 hover:bg-white/10 transition-colors text-sm">
                        Reenviar correo de activación
                    </button>
                </form>
            </div>
        }

        <div class="flex items-center text-text-muted text-sm my-6 before:content-[''] before:flex-1 before:border-b before:border-card-border before:mr-4 after:content-[''] after:flex-1 after:border-b after:border-card-border after:ml-4">o</div>

        <div class="text-center text-sm flex flex-col gap-2">
            <span class="text-text-muted">¿No tienes una cuenta?</span>
            <a asp-action="Register" class="text-accent hover:text-white font-medium transition-colors">Crear cuenta nueva</a>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
