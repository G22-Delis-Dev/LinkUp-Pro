@model LinkUpPro.Application.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = "_Layout";
}

<div class="min-h-[80vh] flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-card-bg border border-card-border rounded-2xl p-8 backdrop-blur-md shadow-2xl relative z-10">
        <h2 class="text-2xl font-bold text-text-primary text-center mb-2">Recuperar Contraseña</h2>
        <p class="text-text-muted text-center mb-6">Ingresa tu correo para recibir un enlace de recuperación</p>

        <form asp-action="ForgotPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="bg-red-500/10 border border-red-500/50 text-red-500 rounded-lg p-3 mb-4 text-sm"></div>

            <div class="mb-6">
                <label asp-for="Email" class="label-custom">Correo Electrónico</label>
                <input asp-for="Email" type="email" class="input-custom" placeholder="juan@ejemplo.com" />
                <span asp-validation-for="Email" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <button type="submit" class="btn-primary-custom mb-4">
                Enviar Enlace
            </button>
            
            <a asp-action="Login" class="block w-full text-center px-4 py-3 rounded-lg border border-white/10 hover:bg-white/5 text-white font-medium transition-colors text-sm">
                Volver a Iniciar Sesión
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
