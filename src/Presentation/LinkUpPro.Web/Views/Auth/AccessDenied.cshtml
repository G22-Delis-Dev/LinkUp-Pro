@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_Layout";
}

<div class="min-h-[80vh] flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-card-bg border border-card-border rounded-2xl p-10 backdrop-blur-md shadow-2xl text-center">

        <!-- Icono -->
        <div class="w-20 h-20 rounded-full bg-red-500/10 border border-red-500/30 flex items-center justify-center mx-auto mb-6">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-red-400">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
            </svg>
        </div>

        <h1 class="text-3xl font-bold text-white mb-2">Acceso Denegado</h1>
        <p class="text-text-muted mb-8">
            No tienes permiso para acceder a este recurso.<br />
            Verifica que estés autenticado con la cuenta correcta.
        </p>

        <div class="flex flex-col gap-3">
            <a asp-controller="Home" asp-action="Index"
               class="btn-primary-custom text-center">
                Ir al inicio
            </a>
            <a asp-controller="Auth" asp-action="Login"
               class="w-full bg-white/5 border border-white/10 text-white font-medium rounded-lg px-4 py-3 hover:bg-white/10 transition-colors text-sm text-center">
                Iniciar sesión con otra cuenta
            </a>
        </div>
    </div>
</div>
