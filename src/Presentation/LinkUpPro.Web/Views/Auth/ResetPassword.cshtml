@model LinkUpPro.Application.ViewModels.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Restablecer Contraseña";
    Layout = "_Layout";
}

<div class="min-h-[80vh] flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-card-bg border border-card-border rounded-2xl p-8 backdrop-blur-md shadow-2xl relative z-10">
        <h2 class="text-2xl font-bold text-text-primary text-center mb-2">Nueva Contraseña</h2>
        <p class="text-text-muted text-center mb-6">Ingresa tu nueva contraseña para LinkUp Pro</p>

        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Token" />
            <input type="hidden" asp-for="Email" />
            <div asp-validation-summary="ModelOnly" class="bg-red-500/10 border border-red-500/50 text-red-500 rounded-lg p-3 mb-4 text-sm"></div>

            <div class="mb-4">
                <label asp-for="NewPassword" class="label-custom">Nueva Contraseña</label>
                <input asp-for="NewPassword" type="password" class="input-custom" id="passwordInput" placeholder="••••••••" />
                
                <div class="mt-2" id="passwordStrengthWrap" style="display: none;">
                    <div class="h-1.5 w-full bg-white/10 rounded-full overflow-hidden">
                        <div class="h-full w-0 transition-all duration-300" id="passwordStrengthBar"></div>
                    </div>
                    <div class="text-xs mt-1 font-medium" id="passwordStrengthText"></div>
                </div>
                
                <span asp-validation-for="NewPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="mb-6">
                <label asp-for="ConfirmPassword" class="label-custom">Confirmar Nueva Contraseña</label>
                <input asp-for="ConfirmPassword" type="password" class="input-custom" placeholder="••••••••" />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <button type="submit" class="btn-primary-custom">
                Restablecer Contraseña
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/passwordStrength.js" asp-append-version="true"></script>
}
