@model LinkUpPro.Application.ViewModels.Post.PostViewModel
@{
    ViewData["Title"] = "Detalle de Publicación";
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto py-8">
    <div class="mb-4">
        <a href="javascript:history.back()" class="inline-flex items-center gap-2 text-text-muted hover:text-white transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Volver
        </a>
    </div>

    <!-- Renderiza el Post usando el Partial (ya adaptado a Tailwind) -->
    <partial name="_PostCard" model="Model" />

    @if (Model.AllowComments)
    {
        <div class="card-static mt-6">
            <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
                    <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
                Comentarios (@Model.CommentCount)
            </h3>
            
            <div class="mb-8">
                <!-- Área para que el usuario escriba un comentario -->
                <form asp-controller="Comment" asp-action="Create" method="post">
                    <input type="hidden" name="PostId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    
                    <div class="flex gap-3">
                        <input type="text" name="Content" class="input-custom flex-grow rounded-r-none" placeholder="Escribe un comentario..." required autocomplete="off" />
                        <button type="submit" class="btn-primary-custom w-auto rounded-l-none px-6">Enviar</button>
                    </div>
                </form>
            </div>

            <!-- Aquí iría la lógica para iterar los comentarios. -->
            <div class="text-center py-12 border border-dashed border-card-border rounded-xl">
                <p class="text-text-muted">Sé el primero en comentar.</p>
            </div>
        </div>
    }
</div>
