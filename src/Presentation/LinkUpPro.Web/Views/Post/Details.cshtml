@model LinkUpPro.Application.ViewModels.Post.PostViewModel
@{
    ViewData["Title"] = "Detalle de Publicación";
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto py-8">
    <div class="mb-4">
        <a href="javascript:history.back()" class="inline-flex items-center gap-2 text-text-muted hover:text-white transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Volver
        </a>
    </div>

    <!-- Renderiza el Post usando el Partial (ya adaptado a Tailwind) -->
    <partial name="_PostCard" model="Model" />

    @{
        var currentUserIdStr = User.FindFirst("uid")?.Value ?? Guid.Empty.ToString();
    }

    <div class="card-static mt-6">
        <h3 class="text-lg font-bold text-white mb-6 flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
            </svg>
            Comentarios (@Model.CommentCount)
        </h3>
        
        @if (Model.AllowComments)
        {
            <div class="mb-8">
                <!-- Área para que el usuario escriba un comentario -->
                <form asp-controller="Comment" asp-action="Create" method="post">
                    <input type="hidden" name="PostId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    
                    <div class="flex gap-3">
                        <input type="text" name="Content" class="input-custom flex-grow rounded-r-none" placeholder="Escribe un comentario..." required autocomplete="off" />
                        <button type="submit" class="btn-primary-custom w-auto rounded-l-none px-6">Enviar</button>
                    </div>
                </form>
            </div>
        }
        else
        {
            <div class="mb-8 p-4 bg-white/5 border border-white/10 rounded-xl text-center">
                <p class="text-text-muted">Los comentarios están desactivados para esta publicación.</p>
            </div>
        }

        @if (Model.Comments.Any())
        {
            <div class="space-y-4">
                @foreach (var comment in Model.Comments)
                {
                    <div class="flex gap-4">
                        <!-- Avatar -->
                        <a asp-controller="Profile" asp-action="View" asp-route-id="@comment.UserId" class="w-10 h-10 rounded-full bg-gradient-to-r from-secondary to-accent flex items-center justify-center text-white font-bold overflow-hidden shadow-sm flex-shrink-0 hover:opacity-90 transition-opacity">
                            @if (!string.IsNullOrEmpty(comment.AuthorProfilePicture))
                            {
                                <img src="@comment.AuthorProfilePicture" alt="@comment.AuthorName" class="w-full h-full object-cover" />
                            }
                            else
                            {
                                <span class="select-none">@comment.AuthorName.Substring(0, 1).ToUpper()</span>
                            }
                        </a>
                        <!-- Comentario -->
                        <div class="flex-1">
                            <div class="bg-card-bg border border-card-border rounded-2xl p-4">
                                <div class="flex justify-between items-start mb-2">
                                    <a asp-controller="Profile" asp-action="View" asp-route-id="@comment.UserId" class="font-semibold text-white hover:text-accent transition-colors">@comment.AuthorName</a>
                                    
                                    <div class="flex items-center gap-3">
                                        <span class="text-xs text-text-muted">@comment.CreatedAt.ToLocalTime().ToString("g")</span>
                                        @if (comment.UserId.ToString() == currentUserIdStr)
                                        {
                                            <button type="button" onclick="document.getElementById('edit-form-@comment.Id').classList.remove('hidden'); document.getElementById('comment-text-@comment.Id').classList.add('hidden');" class="text-accent hover:text-white text-xs flex items-center gap-1 transition-colors" title="Editar comentario">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                                            </button>
                                            <form asp-controller="Comment" asp-action="Delete" method="post" class="inline" onsubmit="return confirm('¿Eliminar este comentario?');">
                                                <input type="hidden" name="id" value="@comment.Id" />
                                                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                                <button type="submit" class="text-red-500 hover:text-red-400 text-xs flex items-center gap-1 transition-colors" title="Eliminar comentario">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </div>
                                <div id="comment-text-@comment.Id">
                                    <p class="text-text-primary text-[15px] leading-relaxed whitespace-pre-wrap">@comment.Content</p>
                                </div>
                                @if (comment.UserId.ToString() == currentUserIdStr)
                                {
                                    <div id="edit-form-@comment.Id" class="hidden mt-2">
                                        <form asp-controller="Comment" asp-action="Edit" method="post" class="flex gap-2">
                                            <input type="hidden" name="id" value="@comment.Id" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <input type="text" name="content" value="@comment.Content" class="input-custom flex-grow text-sm py-1.5" required autocomplete="off" />
                                            <button type="submit" class="btn-primary-custom w-auto py-1.5 px-4 text-sm">Guardar</button>
                                            <button type="button" onclick="document.getElementById('edit-form-@comment.Id').classList.add('hidden'); document.getElementById('comment-text-@comment.Id').classList.remove('hidden');" class="bg-white/5 hover:bg-white/10 text-white font-medium rounded-lg px-4 py-1.5 text-sm transition-colors">Cancelar</button>
                                        </form>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-12 border border-dashed border-card-border rounded-xl">
                <p class="text-text-muted">Sé el primero en comentar.</p>
            </div>
        }
    </div>
</div>
