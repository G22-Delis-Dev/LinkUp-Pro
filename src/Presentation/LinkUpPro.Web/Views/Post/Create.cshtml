@model LinkUpPro.Application.ViewModels.Post.CreatePostViewModel
@{
    ViewData["Title"] = "Crear Publicación";
    Layout = "_Layout";
}

<div class="max-w-2xl mx-auto py-8">
    <div class="card-static">
        <div class="flex items-center justify-between mb-6 border-b border-card-border/50 pb-4">
            <h2 class="text-2xl font-bold text-white">Crear Publicación</h2>
            <a asp-controller="Home" asp-action="Index" class="text-text-muted hover:text-white px-3 py-1 rounded-lg hover:bg-white/5 transition-colors text-sm">Cancelar</a>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="bg-red-500/10 border border-red-500/50 text-red-500 rounded-lg p-3 mb-6 text-sm"></div>

            <div class="mb-6">
                <label asp-for="Content" class="label-custom">¿Qué estás pensando?</label>
                <textarea asp-for="Content" class="input-custom resize-y min-h-[120px]" placeholder="Escribe aquí..."></textarea>
                <span asp-validation-for="Content" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex flex-col md:flex-row gap-6 mb-6">
                <div class="flex-1">
                    <label asp-for="Privacy" class="label-custom">Privacidad</label>
                    <select asp-for="Privacy" class="input-custom appearance-none bg-no-repeat bg-[right_1rem_center] bg-[length:1em]" style="background-image: url('data:image/svg+xml;charset=US-ASCII,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20width%3D%22292.4%22%20height%3D%22292.4%22%3E%3Cpath%20fill%3D%22%2394A3B8%22%20d%3D%22M287%2069.4a17.6%2017.6%200%200%200-13-5.4H18.4c-5%200-9.3%201.8-12.9%205.4A17.6%2017.6%200%200%200%200%2082.2c0%205%201.8%209.3%205.4%2012.9l128%20127.9c3.6%203.6%207.8%205.4%2012.8%205.4s9.2-1.8%2012.8-5.4L287%2095c3.5-3.5%205.4-7.8%205.4-12.8%200-5-1.9-9.2-5.5-12.8z%22%2F%3E%3C%2Fsvg%3E');">
                        <option value="@LinkUpPro.Domain.Enums.Post.PostPrivacy.FriendsOnly">Solo Amigos</option>
                        <option value="@LinkUpPro.Domain.Enums.Post.PostPrivacy.Private">Privado (Solo yo)</option>
                    </select>
                </div>
                <div class="flex-1 flex items-center mt-6 md:mt-0">
                    <label class="flex items-center text-sm text-text-muted cursor-pointer hover:text-white transition-colors">
                        <input asp-for="AllowComments" type="checkbox" class="mr-2 w-4 h-4 rounded border-[#374151] bg-[#111827] text-accent focus:ring-accent" /> 
                        Permitir Comentarios
                    </label>
                </div>
            </div>

            <div class="mb-6">
                <label class="label-custom">Tipo de Contenido Multimedia</label>
                <div class="inline-flex bg-[#111827] p-1 rounded-lg border border-[#374151]">
                    <button type="button" class="toggle-option active px-4 py-2 rounded-md text-sm font-medium transition-colors bg-[#374151] text-white" onclick="setMediaType('None', this)">Texto</button>
                    <button type="button" class="toggle-option px-4 py-2 rounded-md text-sm font-medium transition-colors text-text-muted hover:text-white" onclick="setMediaType('Image', this)">Imagen</button>
                    <button type="button" class="toggle-option px-4 py-2 rounded-md text-sm font-medium transition-colors text-text-muted hover:text-white" onclick="setMediaType('Video', this)">Video (YouTube)</button>
                </div>
                <input type="hidden" asp-for="ContentType" id="hiddenContentType" value="@LinkUpPro.Domain.Enums.Post.PostContentType.Text" />
            </div>

            <!-- Image Upload -->
            <div id="imageSection" class="mb-6" style="display: none;">
                <label asp-for="Image" class="label-custom">Subir Imagen</label>
                <input asp-for="Image" type="file" class="input-custom" accept="image/jpeg,image/png,image/webp" />
                <span asp-validation-for="Image" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <!-- YouTube Video -->
            <div id="videoSection" class="mb-6" style="display: none;">
                <label asp-for="YouTubeUrl" class="label-custom">URL de YouTube</label>
                <input asp-for="YouTubeUrl" class="input-custom" placeholder="https://www.youtube.com/watch?v=..." />
                <span asp-validation-for="YouTubeUrl" class="text-red-500 text-xs mt-1 block"></span>
            </div>

            <div class="pt-6 border-t border-slate-800/80 flex items-center justify-end gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn-secondary-custom">
                    Cancelar
                </a>
                <button type="submit" class="btn-primary-custom">
                    Publicar
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function setMediaType(type, btn) {
            document.querySelectorAll('.toggle-option').forEach(el => {
                el.classList.remove('active', 'bg-[#374151]', 'text-white');
                el.classList.add('text-text-muted');
            });
            btn.classList.remove('text-text-muted');
            btn.classList.add('active', 'bg-[#374151]', 'text-white');
            
            document.getElementById('imageSection').style.display = type === 'Image' ? 'block' : 'none';
            document.getElementById('videoSection').style.display = type === 'Video' ? 'block' : 'none';
            
            let typeId = 0;
            if (type === 'Image') typeId = 1;
            if (type === 'Video') typeId = 2;
            
            document.getElementById('hiddenContentType').value = typeId;
        }
    </script>
}
