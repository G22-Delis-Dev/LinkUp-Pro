@model IEnumerable<LinkUpPro.Application.ViewModels.Post.PostViewModel>
@{
    ViewData["Title"] = "Inicio";
    Layout = "_Layout";
    var currentFilter = ViewBag.CurrentFilter as string ?? "all";
}

<div class="flex flex-col md:flex-row gap-6">
    <!-- Sidebar Izquierdo: Filtros y Acciones Rápida -->
    <div class="w-full md:w-1/4 flex flex-col gap-4">
        <div class="card-static">
            <a asp-controller="Post" asp-action="Create" class="btn-primary-custom flex items-center justify-center gap-2 mb-4">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="5" x2="12" y2="19"></line>
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                </svg>
                Crear Publicación
            </a>
            
            <div class="h-px bg-card-border my-4"></div>
            
            <h3 class="label-custom mb-3">Filtros de Feed</h3>
            <div class="flex flex-col gap-2">
                <a asp-action="Index" asp-route-filter="all" class="px-4 py-2 rounded-lg font-medium transition-colors @(currentFilter == "all" ? "bg-accent/10 text-accent" : "text-text-muted hover:bg-white/5 hover:text-white")">
                    Todos
                </a>
                <a asp-action="Index" asp-route-filter="friends" class="px-4 py-2 rounded-lg font-medium transition-colors @(currentFilter == "friends" ? "bg-accent/10 text-accent" : "text-text-muted hover:bg-white/5 hover:text-white")">
                    Solo Amigos
                </a>
                <a asp-action="Index" asp-route-filter="mine" class="px-4 py-2 rounded-lg font-medium transition-colors @(currentFilter == "mine" ? "bg-accent/10 text-accent" : "text-text-muted hover:bg-white/5 hover:text-white")">
                    Mis Publicaciones
                </a>
            </div>
        </div>
    </div>

    <!-- Feed Principal -->
    <div class="w-full md:w-2/4 flex flex-col gap-6">
        @if (!Model.Any())
        {
            <div class="card-static text-center py-12">
                <div class="w-16 h-16 mx-auto mb-4 text-text-muted opacity-50">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-full h-full">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="3" y1="9" x2="21" y2="9"></line>
                        <line x1="9" y1="21" x2="9" y2="9"></line>
                    </svg>
                </div>
                <h3 class="text-xl font-semibold text-text-primary mb-2">No hay publicaciones</h3>
                <p class="text-text-muted">Aún no hay publicaciones para mostrar en este filtro.</p>
            </div>
        }
        else
        {
            @foreach (var post in Model.OrderByDescending(p => p.CreatedAt))
            {
                <partial name="_PostCard" model="post" />
            }
        }
    </div>

    <!-- Sidebar Derecho: Sugerencias o Info extra (Opcional) -->
    <div class="w-full md:w-1/4">
        <!-- Espacio reservado para widget de amigos conectados -->
    </div>
</div>
