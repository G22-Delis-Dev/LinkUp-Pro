@model List<LinkUpPro.Application.DTOs.Battleship.BattleshipGameDto>
@{
    ViewData["Title"] = "Historial - Battleship";
    var currentUserId = Guid.Parse(User.FindFirst("uid")?.Value ?? Guid.Empty.ToString());
}

<div class="max-w-5xl mx-auto space-y-8">
    <div class="flex justify-between items-center mb-6">
        <div>
            <h1 class="text-3xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-accent to-secondary">Historial Naval</h1>
            <p class="text-text-muted mt-2">Revisa tus partidas finalizadas de Battleship.</p>
        </div>
        <a asp-controller="BattleshipGameList" asp-action="Index" class="px-6 py-3 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-lg transition-colors flex items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            Volver
        </a>
    </div>

    <!-- Estadísticas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="card-static flex items-center justify-between border-b-4 border-blue-500">
            <div>
                <p class="text-text-muted text-sm uppercase tracking-wider font-bold">Jugadas</p>
                <p class="text-4xl font-black mt-2">@ViewBag.TotalPlayed</p>
            </div>
            <div class="w-16 h-16 rounded-full bg-blue-500/20 text-blue-400 flex items-center justify-center">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line x1="8" y1="21" x2="16" y2="21"></line><line x1="12" y1="17" x2="12" y2="21"></line></svg>
            </div>
        </div>
        
        <div class="card-static flex items-center justify-between border-b-4 border-green-500">
            <div>
                <p class="text-text-muted text-sm uppercase tracking-wider font-bold">Ganadas</p>
                <p class="text-4xl font-black mt-2 text-green-400">@ViewBag.TotalWon</p>
            </div>
            <div class="w-16 h-16 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
        </div>
        
        <div class="card-static flex items-center justify-between border-b-4 border-red-500">
            <div>
                <p class="text-text-muted text-sm uppercase tracking-wider font-bold">Perdidas</p>
                <p class="text-4xl font-black mt-2 text-red-400">@ViewBag.TotalLost</p>
            </div>
            <div class="w-16 h-16 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            </div>
        </div>
    </div>

    <!-- Lista de partidas -->
    <div class="card-static">
        @if (!Model.Any())
        {
            <div class="text-center py-12 text-text-muted">
                <p>No tienes partidas finalizadas aún.</p>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-card-border">
                            <th class="p-4 font-bold text-text-muted">ID Partida</th>
                            <th class="p-4 font-bold text-text-muted">Oponente</th>
                            <th class="p-4 font-bold text-text-muted">Resultado</th>
                            <th class="p-4 font-bold text-text-muted text-right">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var game in Model.OrderByDescending(g => g.Id))
                        {
                            var opponentId = game.Player1Id == currentUserId ? game.Player2Id : game.Player1Id;
                            bool won = game.WinnerId == currentUserId;
                            bool draw = game.Result == LinkUpPro.Domain.Enums.Battleship.GameResult.Draw;
                            
                            <tr class="border-b border-card-border/50 hover:bg-white/5 transition-colors">
                                <td class="p-4 font-mono text-sm">@game.Id.ToString().Substring(0,8)...</td>
                                <td class="p-4 font-medium">
                                    @(game.Player1Id == currentUserId ? game.Player2Name : game.Player1Name)
                                </td>
                                <td class="p-4">
                                    @if (game.Status == LinkUpPro.Domain.Enums.Battleship.GameStatus.Canceled)
                                    {
                                        <span class="px-2 py-1 bg-yellow-500/20 text-yellow-500 rounded-md text-xs font-bold">Abandonada</span>
                                    }
                                    else if (won)
                                    {
                                        <span class="px-2 py-1 bg-green-500/20 text-green-400 rounded-md text-xs font-bold flex items-center gap-1 w-max">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg> Victoria
                                        </span>
                                    }
                                    else if (draw)
                                    {
                                        <span class="px-2 py-1 bg-blue-500/20 text-blue-400 rounded-md text-xs font-bold">Empate</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-1 bg-red-500/20 text-red-400 rounded-md text-xs font-bold flex items-center gap-1 w-max">
                                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Derrota
                                        </span>
                                    }
                                </td>
                                <td class="p-4 text-right">
                                    <a href="@Url.Action("Result", "BattleshipResult", new { gameId = game.Id })" class="text-accent hover:underline text-sm font-bold">
                                        Ver Tableros
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
