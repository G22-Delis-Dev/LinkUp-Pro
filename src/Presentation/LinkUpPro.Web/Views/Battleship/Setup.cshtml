@{
    ViewData["Title"] = "Colocar Barcos - Battleship";
    var gameId = ViewBag.GameId;
    var board = ViewBag.Board as LinkUpPro.Application.DTOs.Battleship.BattleshipBoardDto;
    var shipsPlaced = board?.Ships.Count ?? 0;
}

<div class="max-w-6xl mx-auto">
    <div class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-3xl font-bold tracking-tight bg-clip-text text-transparent bg-gradient-to-r from-accent to-secondary">Preparar Flota</h1>
            <p class="text-text-muted mt-2">Coloca tus 5 barcos en el tablero de 12x12.</p>
        </div>
        <div class="text-right">
            <span class="inline-block px-4 py-2 bg-white/5 border border-white/10 rounded-lg font-bold text-accent">
                Barcos colocados: <span id="shipsCount">@shipsPlaced</span>/5
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <!-- Panel Izquierdo: Selección -->
        <div class="lg:col-span-1 space-y-6">
            <div class="card-static">
                <h3 class="text-xl font-bold border-b border-card-border pb-3 mb-4">Seleccionar Barco</h3>
                
                <div id="shipSelection" class="space-y-3">
                    <!-- Los barcos se deshabilitarán al colocarlos. Tamaño: 5, 4, 3, 3, 2 -->
                    <button class="ship-select-btn w-full flex items-center justify-between p-3 rounded-xl border border-white/10 hover:border-accent transition-colors bg-white/5" data-size="5" data-name="Portaaviones (5)">
                        <span class="font-medium">Portaaviones</span>
                        <div class="flex gap-1">
                            @for(int i=0; i<5; i++) { <div class="w-4 h-4 bg-accent/80 rounded-sm"></div> }
                        </div>
                    </button>
                    
                    <button class="ship-select-btn w-full flex items-center justify-between p-3 rounded-xl border border-white/10 hover:border-accent transition-colors bg-white/5" data-size="4" data-name="Acorazado (4)">
                        <span class="font-medium">Acorazado</span>
                        <div class="flex gap-1">
                            @for(int i=0; i<4; i++) { <div class="w-4 h-4 bg-accent/80 rounded-sm"></div> }
                        </div>
                    </button>

                    <button class="ship-select-btn w-full flex items-center justify-between p-3 rounded-xl border border-white/10 hover:border-accent transition-colors bg-white/5" data-size="3" data-name="Crucero (3)">
                        <span class="font-medium">Crucero</span>
                        <div class="flex gap-1">
                            @for(int i=0; i<3; i++) { <div class="w-4 h-4 bg-accent/80 rounded-sm"></div> }
                        </div>
                    </button>

                    <button class="ship-select-btn w-full flex items-center justify-between p-3 rounded-xl border border-white/10 hover:border-accent transition-colors bg-white/5" data-size="3" data-name="Submarino (3)">
                        <span class="font-medium">Submarino</span>
                        <div class="flex gap-1">
                            @for(int i=0; i<3; i++) { <div class="w-4 h-4 bg-accent/80 rounded-sm"></div> }
                        </div>
                    </button>

                    <button class="ship-select-btn w-full flex items-center justify-between p-3 rounded-xl border border-white/10 hover:border-accent transition-colors bg-white/5" data-size="2" data-name="Destructor (2)">
                        <span class="font-medium">Destructor</span>
                        <div class="flex gap-1">
                            @for(int i=0; i<2; i++) { <div class="w-4 h-4 bg-accent/80 rounded-sm"></div> }
                        </div>
                    </button>
                </div>
            </div>

            <div class="card-static">
                <h3 class="text-xl font-bold border-b border-card-border pb-3 mb-4">Dirección</h3>
                <div class="flex bg-primary p-1 rounded-xl">
                    <button id="dirHorizontal" class="flex-1 py-2 text-center rounded-lg bg-accent/20 text-accent font-semibold transition-all">
                        Horizontal
                    </button>
                    <button id="dirVertical" class="flex-1 py-2 text-center rounded-lg text-text-muted hover:text-white font-semibold transition-all">
                        Vertical
                    </button>
                </div>
                <input type="hidden" id="currentDirection" value="0" /> <!-- 0: Horizontal, 1: Vertical -->
            </div>

            @if (shipsPlaced == 5)
            {
                <form asp-controller="BattleshipShipPlace" asp-action="ConfirmSetup" method="post">
                    <input type="hidden" name="gameId" value="@gameId" />
                    <button type="submit" class="btn-primary-custom w-full py-4 text-lg animate-pulse">
                        ¡Confirmar Flota!
                    </button>
                </form>
            }
            else
            {
                <div id="confirmContainer" class="hidden">
                    <form asp-controller="BattleshipShipPlace" asp-action="ConfirmSetup" method="post">
                        <input type="hidden" name="gameId" value="@gameId" />
                        <button type="submit" class="btn-primary-custom w-full py-4 text-lg animate-pulse">
                            ¡Confirmar Flota!
                        </button>
                    </form>
                </div>
            }
            
            <!-- Mensajes de error AJAX -->
            <div id="setupError" class="hidden bg-red-500/10 border border-red-500/20 text-red-400 p-4 rounded-xl text-sm"></div>
        </div>

        <!-- Tablero 12x12 -->
        <div class="lg:col-span-2 flex justify-center">
            <div class="card-static p-2 md:p-6 w-full max-w-2xl overflow-x-auto">
                <div id="setupBoard" class="battleship-grid bg-primary border-2 border-white/5 rounded-lg p-2" data-game-id="@gameId">
                    <!-- Generado por JS -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Datos iniciales -->
<script>
    window.initialShips = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(board?.Ships ?? new List<LinkUpPro.Application.DTOs.Battleship.ShipDto>()));
    window.gameId = '@gameId';
    window.placeShipUrl = '@Url.Action("Place", "BattleshipShipPlace")';
</script>

@section Scripts {
    <script src="~/js/battleship-board.js" asp-append-version="true"></script>
}
