@{
    ViewData["Title"] = "Batalla - Battleship";
    var game = ViewBag.Game as LinkUpPro.Application.DTOs.Battleship.BattleshipGameDto;
    var opponentBoard = ViewBag.OpponentBoard as LinkUpPro.Application.DTOs.Battleship.BattleshipBoardDto;
    var currentUserId = (Guid)ViewBag.CurrentUserId;
    var isMyTurn = game?.CurrentTurnPlayerId == currentUserId;
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 bg-primary p-4 rounded-xl border border-card-border shadow-lg mb-8 relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-r from-accent/10 to-transparent pointer-events-none"></div>
        <div class="relative z-10 flex items-center gap-4">
            <div class="w-12 h-12 rounded-full flex items-center justify-center font-bold text-2xl @(isMyTurn ? "bg-accent text-primary shadow-[0_0_20px_rgba(0,212,255,0.6)] animate-pulse" : "bg-white/10 text-text-muted")">
                @(isMyTurn ? "!" : "?")
            </div>
            <div>
                <h2 class="text-2xl font-bold tracking-tight text-white">@(isMyTurn ? "¡Es tu turno!" : "Turno del oponente")</h2>
                <p class="text-text-muted text-sm">@(isMyTurn ? "Selecciona una coordenada en el tablero enemigo para atacar." : "Espera a que el oponente realice su movimiento.")</p>
            </div>
        </div>
        
        <div class="relative z-10 flex gap-3">
            <button onclick="location.reload();" class="btn-primary-custom">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.59-9.21l-5.6 5.6"></path>
                </svg>
                Refrescar
            </button>
            <form asp-controller="BattleshipSurrender" asp-action="Surrender" method="post" onsubmit="return confirm('¿Estás seguro que deseas rendirte?');">
                <input type="hidden" name="gameId" value="@game?.Id" />
                <button type="submit" class="btn-danger-custom">
                    Rendirse
                </button>
            </form>
        </div>
    </div>

    <!-- Error/Success Banner -->
    <div id="attackMessage" class="hidden p-4 rounded-xl font-bold text-center mb-6"></div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        <!-- Tablero Enemigo (Para atacar) -->
        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="text-2xl font-bold flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-red-500 shadow-[0_0_10px_rgba(239,68,68,0.8)]"></span>
                    Flota Enemiga
                </h3>
                <div class="text-xs font-bold flex gap-3 text-text-muted">
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-red-500"></span> Hit</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 bg-white"></span> Miss</span>
                </div>
            </div>
            
            <div class="card-static p-2 md:p-6 w-full overflow-x-auto relative" id="enemyBoardContainer">
                @if (!isMyTurn)
                {
                    <div class="absolute inset-0 bg-black/50 backdrop-blur-[1px] z-20 flex flex-col items-center justify-center rounded-xl">
                        <svg class="animate-spin h-10 w-10 text-accent mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                        <p class="font-bold text-lg text-white drop-shadow-md">Esperando ataque...</p>
                    </div>
                }
                
                <div class="grid grid-cols-13 gap-1 w-full" style="grid-template-columns: repeat(13, minmax(0, 1fr));">
                    <div class="w-6 h-6 md:w-10 md:h-10"></div>
                    @for (int i = 0; i < 12; i++)
                    {
                        <div class="w-6 h-6 md:w-10 md:h-10 flex items-center justify-center font-bold text-accent/50 text-sm">@(char.ConvertFromUtf32(65 + i))</div>
                    }

                    @for (int y = 0; y < 12; y++)
                    {
                        <div class="w-6 h-6 md:w-10 md:h-10 flex items-center justify-center font-bold text-accent/50 text-sm">@(y + 1)</div>
                        
                        @for (int x = 0; x < 12; x++)
                        {
                            var attack = opponentBoard?.ReceivedAttacks.FirstOrDefault(a => a.CoordinateX == x && a.CoordinateY == y);
                            string cellClass = "bg-black/20 hover:bg-accent/20 cursor-pointer";
                            string onclick = $"onclick=\"attackCell({x}, {y})\"";

                            if (attack != null)
                            {
                                onclick = ""; // Deshabilitar si ya se atacó
                                if (attack.IsHit) cellClass = "bg-red-500/80 shadow-[0_0_10px_rgba(239,68,68,0.5)] cursor-not-allowed";
                                else cellClass = "bg-white/80 cursor-not-allowed";
                            }
                            
                            <div class="w-6 h-6 md:w-10 md:h-10 border border-white/5 rounded-sm transition-colors @cellClass" @Html.Raw(onclick) id="cell-@x-@y">
                                @if (attack != null)
                                {
                                    <div class="w-full h-full flex items-center justify-center">
                                        @if(attack.IsHit) { <span class="text-white font-black text-sm md:text-base">X</span> }
                                        else { <span class="text-black font-black text-sm md:text-base">•</span> }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <!-- Mi Tablero -->
        <div class="space-y-4">
            <div class="flex justify-between items-center">
                <h3 class="text-2xl font-bold flex items-center gap-2">
                    <span class="w-4 h-4 rounded-full bg-accent shadow-[0_0_10px_rgba(0,212,255,0.8)]"></span>
                    Mi Flota
                </h3>
            </div>
            
            <div id="myBoardContainer">
                <div class="card-static p-6 flex justify-center items-center h-64">
                    <svg class="animate-spin h-8 w-8 text-accent" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script>
        const gameId = '@game?.Id';
        const isMyTurn = @(isMyTurn.ToString().ToLower());
        const attackUrl = '@Url.Action("Attack", "BattleshipAttack")';
        const loadMyBoardUrl = '@Url.Action("Board", "BattleshipMyBoard", new { gameId = game?.Id })';

        $(document).ready(function () {
            loadMyBoard();
        });

        function loadMyBoard() {
            $.get(loadMyBoardUrl, function(data) {
                $('#myBoardContainer').html(data);
            }).fail(function() {
                $('#myBoardContainer').html('<div class="text-red-400 p-4 text-center">Error al cargar el tablero.</div>');
            });
        }

        function attackCell(x, y) {
            if (!isMyTurn) return;
            
            let token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content')
                     || $('input[name="__RequestVerificationToken"]').val();
            
            $.ajax({
                url: attackUrl,
                type: 'POST',
                contentType: 'application/json',
                headers: { 'X-CSRF-TOKEN': token },
                data: JSON.stringify({
                    GameId: gameId,
                    TargetX: x,
                    TargetY: y
                }),
                success: function(response) {
                    if (response.success) {
                        let res = response.result;
                        let cell = $(`#cell-${x}-${y}`);
                        cell.removeAttr('onclick').removeClass('bg-black/20 hover:bg-accent/20 cursor-pointer');
                        
                        if (res.isHit) {
                            cell.addClass('bg-red-500/80 shadow-[0_0_10px_rgba(239,68,68,0.5)] cursor-not-allowed');
                            cell.html('<div class="w-full h-full flex items-center justify-center"><span class="text-white font-black">X</span></div>');
                            
                            showMessage(`¡Impacto! ${res.isSunk ? `¡Hundiste un barco!` : ''}`, 'success');
                        } else {
                            cell.addClass('bg-white/80 cursor-not-allowed');
                            cell.html('<div class="w-full h-full flex items-center justify-center"><span class="text-black font-black">•</span></div>');
                            
                            showMessage('Agua. Turno del oponente.', 'warning');
                        }
                        
                        if (res.isGameOver) {
                            setTimeout(() => {
                                window.location.href = '@Url.Action("Result", "BattleshipResult", new { gameId = game?.Id })';
                            }, 2000);
                        } else {
                            // Recargar página después de un momento para cambiar turnos
                            setTimeout(() => {
                                window.location.reload();
                            }, 1500);
                        }
                    } else {
                        showMessage(response.message, 'error');
                    }
                },
                error: function() {
                    showMessage('Error al conectar con el servidor', 'error');
                }
            });
        }

        function showMessage(msg, type) {
            let banner = $('#attackMessage');
            banner.removeClass('hidden bg-green-500/20 text-green-400 bg-red-500/20 text-red-400 bg-yellow-500/20 text-yellow-400 border-green-500/30 border-red-500/30 border-yellow-500/30');
            
            if (type === 'success') banner.addClass('bg-green-500/20 text-green-400 border border-green-500/30');
            else if (type === 'error') banner.addClass('bg-red-500/20 text-red-400 border border-red-500/30');
            else if (type === 'warning') banner.addClass('bg-yellow-500/20 text-yellow-400 border border-yellow-500/30');
            
            banner.text(msg);
        }
    </script>
}
