@model LinkUpPro.Application.ViewModels.Battleship.CreateGameViewModel
@using LinkUpPro.Application.DTOs.Friendship
@{
    ViewData["Title"] = "Nueva Partida de Battleship";
    var friends = ViewBag.Friends as List<FriendshipDto> ?? new List<FriendshipDto>();
}

<div class="max-w-2xl mx-auto">
    <div class="card-static">
        <!-- Header -->
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-accent/20 text-accent mb-4">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
            </div>
            <h1 class="text-3xl font-bold tracking-tight">Nueva Partida</h1>
            <p class="text-text-muted mt-2">Selecciona un amigo para retarlo en Battleship.</p>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 rounded-lg bg-red-500/10 border border-red-500/30 text-red-400 text-sm">
                @TempData["Error"]
            </div>
        }

        <form asp-controller="BattleshipGameCreate" asp-action="Create" method="post" id="createGameForm" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="OpponentId" id="opponentIdInput" />

            @if (!friends.Any())
            {
                <!-- Sin amigos -->
                <div class="text-center py-10 px-4 rounded-xl bg-white/5 border border-card-border">
                    <svg class="mx-auto mb-4 text-text-muted" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    <p class="text-text-muted font-medium">Aún no tienes amigos.</p>
                    <p class="text-text-muted text-sm mt-1">Añade amigos primero para poder retarlos.</p>
                    <a asp-controller="FriendRequestSend" asp-action="Create"
                       class="inline-flex items-center gap-2 mt-4 text-accent hover:text-white transition-colors text-sm font-semibold">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <line x1="5" y1="12" x2="19" y2="12"></line>
                        </svg>
                        Añadir un amigo
                    </a>
                </div>
            }
            else
            {
                <!-- Buscador de amigos (filtro lado cliente) -->
                <div>
                    <label class="label-custom">Buscar entre tus amigos</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-text-muted">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                            </svg>
                        </div>
                        <input
                            type="text"
                            id="friendSearch"
                            class="input-custom pl-10"
                            placeholder="Escribe un nombre..."
                            autocomplete="off" />
                    </div>
                </div>

                <!-- Lista de amigos -->
                <div>
                    <p class="text-xs font-semibold uppercase tracking-widest text-text-muted mb-3">
                        Tus amigos (<span id="friendCount">@friends.Count</span>)
                    </p>
                    <div id="friendsList" class="space-y-2 max-h-72 overflow-y-auto pr-1">
                        @foreach (var friend in friends)
                        {
                            var initials = string.Join("", friend.FriendName.Split(' ').Take(2).Select(n => n[0])).ToUpper();
                            <button type="button"
                                    data-friend-id="@friend.FriendId"
                                    data-friend-name="@friend.FriendName"
                                    class="friend-card w-full flex items-center gap-3 p-3 rounded-xl hover:bg-white/5 border border-transparent hover:border-accent/30 transition-all text-left group">
                                @if (!string.IsNullOrEmpty(friend.FriendProfilePicture))
                                {
                                    <img src="@Url.Action("Get", "ProfilePicture", new { path = friend.FriendProfilePicture })"
                                         class="w-12 h-12 rounded-full object-cover flex-shrink-0"
                                         alt="@friend.FriendName"
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                    <div class="w-12 h-12 rounded-full bg-accent/20 text-accent font-bold text-base items-center justify-center flex-shrink-0 hidden">@initials</div>
                                }
                                else
                                {
                                    <div class="w-12 h-12 rounded-full bg-accent/20 text-accent font-bold text-base flex items-center justify-center flex-shrink-0">@initials</div>
                                }
                                <div class="flex-1 min-w-0">
                                    <p class="font-medium text-white group-hover:text-accent transition-colors truncate">@friend.FriendName</p>
                                    <p class="text-xs text-text-muted mt-0.5">Amigos desde @friend.Since.ToString("MMM yyyy")</p>
                                </div>
                                <span class="text-xs text-accent opacity-0 group-hover:opacity-100 transition-opacity flex-shrink-0">Retar</span>
                            </button>
                        }
                    </div>
                    <p id="noFriendsFound" class="hidden text-center text-text-muted py-6 text-sm">
                        No se encontraron amigos con ese nombre.
                    </p>
                </div>

                <!-- Oponente seleccionado -->
                <div id="selectedOpponent" class="hidden p-4 rounded-xl border border-accent/50 bg-accent/5 flex items-center gap-4">
                    <div id="opponentAvatar" class="w-12 h-12 rounded-full flex items-center justify-center bg-accent/20 text-accent font-bold text-lg flex-shrink-0"></div>
                    <div class="flex-1 min-w-0">
                        <p class="font-semibold text-white truncate" id="opponentName"></p>
                        <p class="text-xs text-accent mt-0.5">Seleccionado como oponente</p>
                    </div>
                    <button type="button" id="deselectOpponent" class="text-text-muted hover:text-white transition-colors flex-shrink-0">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <line x1="18" y1="6" x2="6" y2="18"></line>
                            <line x1="6" y1="6" x2="18" y2="18"></line>
                        </svg>
                    </button>
                </div>
            }

            <!-- Botones -->
            <div class="flex gap-4 pt-4">
                <a asp-controller="BattleshipGameList" asp-action="Index"
                   class="px-6 py-3 bg-white/5 hover:bg-white/10 text-white font-semibold rounded-lg transition-colors flex-1 text-center">
                    Cancelar
                </a>
                <button type="submit" id="submitBtn" @(!friends.Any() ? "disabled" : "") 
                    class="btn-primary-custom flex-1 flex justify-center items-center gap-2 disabled:opacity-40 disabled:cursor-not-allowed disabled:shadow-none">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                    Crear Partida
                </button>
            </div>
        </form>
    </div>
</div>

@if (friends.Any())
{
    <script>
    (function () {
        const friendSearch     = document.getElementById('friendSearch');
        const friendsList      = document.getElementById('friendsList');
        const noFriendsFound   = document.getElementById('noFriendsFound');
        const friendCountEl    = document.getElementById('friendCount');
        const selectedOpponent = document.getElementById('selectedOpponent');
        const opponentName     = document.getElementById('opponentName');
        const opponentAvatar   = document.getElementById('opponentAvatar');
        const opponentIdInput  = document.getElementById('opponentIdInput');
        const submitBtn        = document.getElementById('submitBtn');
        const allCards         = document.querySelectorAll('.friend-card');

        // Inicialmente deshabilitar submit
        submitBtn.disabled = true;

        function getInitials(name) {
            return name.split(' ').slice(0, 2).map(n => n[0]).join('').toUpperCase();
        }

        function selectOpponent(id, name, pictureEl) {
            opponentIdInput.value = id;
            opponentName.textContent = name;

            // Clonar imagen si existe
            const img = pictureEl ? pictureEl.querySelector('img') : null;
            if (img && !img.hidden) {
                opponentAvatar.innerHTML = '';
                const cloned = img.cloneNode();
                cloned.className = 'w-full h-full rounded-full object-cover';
                opponentAvatar.appendChild(cloned);
            } else {
                opponentAvatar.textContent = getInitials(name);
            }

            // Marcar tarjeta activa
            allCards.forEach(c => c.classList.remove('border-accent', 'bg-accent/10'));
            const activeCard = [...allCards].find(c => c.dataset.friendId === id);
            if (activeCard) activeCard.classList.add('border-accent', 'bg-accent/10');

            selectedOpponent.classList.remove('hidden');
            submitBtn.disabled = false;
        }

        function deselectOpponent() {
            opponentIdInput.value = '';
            selectedOpponent.classList.add('hidden');
            submitBtn.disabled = true;
            allCards.forEach(c => c.classList.remove('border-accent', 'bg-accent/10'));
        }

        document.getElementById('deselectOpponent').addEventListener('click', deselectOpponent);

        allCards.forEach(card => {
            card.addEventListener('click', function () {
                selectOpponent(this.dataset.friendId, this.dataset.friendName, this);
            });
        });

        // Filtro cliente
        friendSearch.addEventListener('input', function () {
            const q = this.value.toLowerCase().trim();
            let visible = 0;
            allCards.forEach(card => {
                const name = card.dataset.friendName.toLowerCase();
                const show = !q || name.includes(q);
                card.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            friendCountEl.textContent = visible;
            noFriendsFound.classList.toggle('hidden', visible > 0);
        });
    })();
    </script>
}
