@{
    ViewData["Title"] = "Battleship - Menú Principal";
    var activeGames = ViewBag.ActiveGames as List<LinkUpPro.Application.DTOs.Battleship.BattleshipGameDto>;
    var history = ViewBag.History as List<LinkUpPro.Application.DTOs.Battleship.BattleshipGameDto>;
    var currentUserId = Guid.Parse(User.FindFirst("uid")?.Value ?? Guid.Empty.ToString());
}

<div class="max-w-5xl mx-auto space-y-10">
    <!-- Header -->
    <div class="card-static relative overflow-hidden flex flex-col md:flex-row justify-between items-center p-8">
        <div class="absolute inset-0 bg-gradient-to-br from-secondary/20 to-accent/20 blur-2xl z-0"></div>
        <div class="relative z-10 text-center md:text-left mb-6 md:mb-0">
            <h1 class="text-4xl font-black tracking-tight text-white drop-shadow-md">
                BATTLE<span class="text-accent">SHIP</span>
            </h1>
            <p class="text-text-muted mt-2 text-lg">El clásico juego naval ahora con tus amigos.</p>
        </div>
        <div class="relative z-10">
            <a asp-controller="BattleshipGameCreate" asp-action="Create" class="btn-primary-custom flex items-center gap-2 text-lg px-8 py-4 shadow-[0_0_20px_rgba(0,212,255,0.4)] hover:shadow-[0_0_30px_rgba(0,212,255,0.6)]">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                Iniciar Nueva Partida
            </a>
        </div>
    </div>

    <!-- Partidas Activas -->
    <div>
        <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-accent">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            Partidas en Curso
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            @if (activeGames == null || !activeGames.Any())
            {
                <div class="col-span-full card-static text-center py-10">
                    <p class="text-text-muted">No tienes partidas activas en este momento.</p>
                </div>
            }
            else
            {
                foreach (var game in activeGames)
                {
                    var isMyTurn = game.CurrentTurnPlayerId == currentUserId;
                    var opponentId = game.Player1Id == currentUserId ? game.Player2Id : game.Player1Id;
                    
                    <div class="card-static flex flex-col justify-between hover:border-accent/50 transition-all shadow-lg hover:shadow-accent/20 border-l-4 @(isMyTurn ? "border-l-accent" : "border-l-text-muted")">
                        <div class="mb-4">
                            <div class="flex justify-between items-start mb-2">
                                <span class="px-3 py-1 text-xs font-bold rounded-full @(game.Status == LinkUpPro.Domain.Enums.Battleship.GameStatus.PlacingShips ? "bg-secondary/20 text-secondary" : "bg-accent/20 text-accent")">
                                    @game.Status.ToString()
                                </span>
                                <span class="text-xs text-text-muted">ID: @game.Id.ToString().Substring(0, 8)</span>
                            </div>
                            <h3 class="text-lg font-bold">vs Jugador @opponentId.ToString().Substring(0, 5)</h3>
                            
                            @if (game.Status == LinkUpPro.Domain.Enums.Battleship.GameStatus.InProgress)
                            {
                                <p class="text-sm mt-2 font-medium @(isMyTurn ? "text-accent" : "text-text-muted")">
                                    @(isMyTurn ? "¡Es tu turno! Ataca." : "Esperando al oponente...")
                                </p>
                            }
                            else if (game.Status == LinkUpPro.Domain.Enums.Battleship.GameStatus.PlacingShips)
                            {
                                <p class="text-sm mt-2 text-text-muted">Colocación de barcos</p>
                            }
                        </div>
                        
                        <div class="flex gap-3 mt-4 pt-4 border-t border-card-border">
                            @if (game.Status == LinkUpPro.Domain.Enums.Battleship.GameStatus.PlacingShips)
                            {
                                <a href="@Url.Action("Setup", "BattleshipSetup", new { gameId = game.Id })" class="btn-primary-custom text-sm flex-1 text-center">Ir al Tablero</a>
                            }
                            else
                            {
                                <a href="@Url.Action("Index", "BattleshipAttack", new { gameId = game.Id })" class="btn-primary-custom text-sm flex-1 text-center">Ir a Batalla</a>
                            }
                            
                            <form asp-controller="BattleshipSurrender" asp-action="Surrender" method="post" onsubmit="return confirm('¿Estás seguro que deseas rendirte? Perderás la partida.');">
                                <input type="hidden" name="gameId" value="@game.Id" />
                                <button type="submit" class="px-4 py-2 bg-red-500/10 text-red-400 hover:bg-red-500 hover:text-white rounded-lg transition-colors text-sm font-semibold h-full flex items-center justify-center">
                                    Rendirse
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    
    <div class="text-center pt-8 border-t border-card-border">
        <a asp-controller="BattleshipHistory" asp-action="Index" class="text-accent hover:text-white hover:underline transition-colors flex items-center justify-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 22h14a2 2 0 0 0 2-2V7.5L14.5 2H6a2 2 0 0 0-2 2v4"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <path d="M3 15h6"></path>
                <path d="M3 18h6"></path>
            </svg>
            Ver Historial Completo
        </a>
    </div>
</div>
