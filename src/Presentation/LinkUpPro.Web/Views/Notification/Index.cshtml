@model IEnumerable<LinkUpPro.Application.DTOs.Notification.NotificationDto>
@{
    ViewData["Title"] = "Notificaciones";
    Layout = "_Layout";
}

<div class="max-w-3xl mx-auto py-8">
    <div class="card-static p-0 overflow-hidden">
        
        <!-- Header -->
        <div class="p-6 border-b border-card-border/50 flex items-center justify-between bg-white/5">
            <h2 class="text-2xl font-bold text-white flex items-center gap-3">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent">
                    <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                    <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                </svg>
                Notificaciones
            </h2>
            @if (Model.Any())
            {
                <form asp-action="MarkAllAsRead" method="post">
                    <button type="submit" class="text-sm px-4 py-2 bg-white/10 hover:bg-white/20 text-white rounded-lg transition-colors border border-white/10">
                        Marcar todas como leídas
                    </button>
                </form>
            }
        </div>

        <!-- Lista -->
        <div class="divide-y divide-card-border/50">
            @if (!Model.Any())
            {
                <div class="p-12 text-center text-text-muted">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 opacity-50">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                    <p class="text-lg">No tienes notificaciones nuevas.</p>
                </div>
            }
            else
            {
                foreach (var notif in Model.OrderByDescending(n => n.CreatedAt))
                {
                    <div class="p-4 md:p-6 hover:bg-white/5 transition-colors flex items-start gap-4 relative group" id="notif-@notif.Id">
                        
                        <!-- Icono según tipo -->
                        <div class="w-10 h-10 rounded-full bg-accent/20 flex items-center justify-center text-accent flex-shrink-0">
                            @if (notif.Type == LinkUpPro.Domain.Enums.Notification.NotificationType.FriendRequestReceived)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H5c-1.1 0-2 .9-2 2v2"></path><circle cx="8.5" cy="7" r="4"></circle><line x1="20" y1="8" x2="20" y2="14"></line><line x1="23" y1="11" x2="17" y2="11"></line></svg>
                            }
                            else if (notif.Type == LinkUpPro.Domain.Enums.Notification.NotificationType.NewComment)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
                            }
                            else if (notif.Type == LinkUpPro.Domain.Enums.Notification.NotificationType.NewReaction)
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>
                            }
                            else
                            {
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            }
                        </div>
                        
                        <div class="flex-grow">
                            <p class="text-text-primary text-sm leading-relaxed">
                                @notif.Message
                            </p>
                            <span class="text-xs text-text-muted mt-1 block">@notif.CreatedAt.ToString("g")</span>
                        </div>
                        
                        <button type="button" class="md:opacity-0 group-hover:opacity-100 transition-opacity p-2 text-text-muted hover:text-accent hover:bg-accent/10 rounded-lg focus:outline-none" onclick="markAsRead('@notif.Id')" title="Marcar como leída">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </button>
                    </div>
                }
            }
        </div>
    </div>
</div>

<script>
    function markAsRead(id) {
        fetch('/Notification/MarkAsRead', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded'
            },
            body: 'id=' + id
        }).then(res => res.json()).then(data => {
            if (data.success) {
                // Eliminar del DOM con animación
                const el = document.getElementById('notif-' + id);
                if (el) {
                    el.style.opacity = '0';
                    setTimeout(() => el.remove(), 300);
                }
            }
        });
    }
</script>
